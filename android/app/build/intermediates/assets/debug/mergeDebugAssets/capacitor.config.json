{
	"appId": "com.koffiestasiun.pos",
	"appName": "KoffiePOS",
	"webDir": "public",
	"server": {
		"url": "http://192.168.108.123:3000",
		"cleartext": true,
		"androidScheme": "https",
		"allowNavigation": [
			"*.supabase.co",
			"*.supabase.in",
			"localhost",
			"192.168.*.*",
			"10.*.*.*"
		]
	},
	"android": {
		"backgroundColor": "#1B5E20"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"launchAutoHide": true,
			"launchFadeOutDuration": 500,
			"backgroundColor": "#1B5E20",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false,
			"spinnerColor": "#C08B5C"
		},
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#1B5E20"
		}
	}
}
